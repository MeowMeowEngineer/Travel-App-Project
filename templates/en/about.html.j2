} %}
{% set S = SOS_ALL.get(loc.html) or SOS_ALL['en'] %}
<section class="wrap chapter ch-rail" id="emergency" aria-labelledby="h-sos">
  <h2 id="h-sos" class="rail-label">{{ S.h }}</h2>
  <div class="rail-body prose">
    <p>{{ S.lead }}</p>
    <ul class="sos">
      {% for x in em.lines %}<li><a class="sos-tel tn" href="tel:{{ x.tel }}" data-track="tel_click">{{ x.tel }}</a><span class="sos-what">{{ S[x.what] }}{% if x.abroad %} · {{ S.abroad }} <a href="tel:{{ x.abroad }}" data-track="tel_click">{{ x.abroad }}</a>{% endif %}</span></li>{% endfor %}
    </ul>
    {% for s in em.steps %}<p>{{ S[s.id] }}</p>{% endfor %}
    {% set sos_links %}{% for k, s in em.sources.items() %}<a href="{{ s.url }}" rel="noopener"{% if loc.html != 'en' %} hreflang="en"{% endif %} data-track="official_click">{{ S[k] }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% endset %}
    <p class="sos-src">{{ (S.src|e)|replace('{p}', t.kto_visitkorea)|replace('{l}', sos_links) }}</p>
  </div>
</section>
{% endif %}

<section class="wrap chapter ch-rail" id="chatbot" aria-labelledby="h-chatbot">
  <h2 id="h-chatbot" class="rail-label">Site assistant</h2>
  <div class="rail-body prose">
    <p>The ‘Ask’ button at the bottom right opens an assistant that answers only from this site's information: the values and sources on its place, guide, course and event pages, with a link to each page it uses. Where two sources differ it gives both; where the site has no value it says so and points to the phone number or official website in the data.</p>
    <p>Answers are written by Claude Haiku 5.5, an AI model by Anthropic. AI answers can be wrong: check the linked pages and the official sources before you go. It cannot book, pay or sign you up; it only links to official booking pages.</p>
    <p>This site does not store conversations on its server. The conversation stays only in this browser tab and is cleared when you press ‘New chat’ or close the tab. Each time you ask, the new question, the conversation before it (the last 12 messages) and the address of the page you are on go through this site's server function to the Anthropic API, which writes the answer. The server log keeps only the outcome and usage numbers, never your questions or the answers. What happens to them at Anthropic follows Anthropic's policies, and this site cannot delete what has already been sent.</p>
    <p>Please do not type personal details such as names or phone numbers: nothing masks them automatically. If you typed one by mistake, press ‘New chat’; otherwise it is sent again with the conversation the next time you ask.</p>
  </div>
</section>

<section class="wrap chapter ch-rail" aria-labelledby="corrections">
  {% set mail %}{% if site.operator.contact %}<a href="mailto:{{ site.operator.contact }}">{{ site.operator.contact }}</a>{% else %}{{ t.the_operator }}{% endif %}{% endset %}
  {% set op %}{% if site.operator.name_en %}{{ site.operator.name_en }} (<span lang="ko">{{ site.operator.name }}</span>){% else %}<span lang="ko">{{ site.operator.name }}</span>{% endif %}{% endset %}
  <h2 id="corrections" class="rail-label">{{ t.report_error }}</h2>
  <div class="rail-body prose">
    <p>{{ t.f('about_report', mail=mail) }}</p>
    <p>{{ t.f('about_operator', op=op) }}</p>
  </div>
</section>

{%- set op = site.operator %}
{%- if op.business_no %}
{#- the company that runs the site, as its official papers and its own site give it (operator 2026-10-17, the CEO's mail;
    site.json operator.sources): names in Korean beside the English, addresses as the company's English site writes them -#}
<section class="wrap chapter ch-rail" id="company" aria-labelledby="h-company">
  <h2 id="h-company" class="rail-label">{{ t.co_heading }}</h2>
  <div class="rail-body">
    {%- set ed_role = (site.editor.role_en if loc.code == 'en' and site.editor else '') or t.editor_role %}
    <dl class="src-dl co-dl">
      <div><dt>{{ t.co_name }}</dt><dd>{% if op.name_en %}{{ op.name_en }} (<span lang="ko">{{ op.legal_name or op.name }}</span>){% else %}<span lang="ko">{{ op.legal_name or op.name }}</span>{% endif %}{% if loc.code == 'en' and op.about_en %}, {{ op.about_en }}{% endif %}</dd></div>
      {% if op.ceo %}<div><dt>{{ t.co_ceo }}</dt><dd>{% if loc.code == 'en' and op.ceo_en %}{{ op.ceo_en }} (<span lang="ko">{{ op.ceo }}</span>){% else %}<span lang="ko">{{ op.ceo }}</span>{% if op.ceo_en %} ({{ op.ceo_en }}){% endif %}{% endif %}</dd></div>{% endif %}
      <div><dt>{{ t.co_biz_no }}</dt><dd>{{ op.business_no }}</dd></div>
      {% if op.corporate_no %}<div><dt>{{ t.co_corp_no }}</dt><dd>{{ op.corporate_no }}</dd></div>{% endif %}
      {% if op.founded %}<div><dt>{{ t.co_founded }}</dt><dd>{{ loc.date_bare(op.founded) }}</dd></div>{% endif %}
      {% if op.head_office_en %}<div><dt>{{ t.co_head_office }}</dt><dd>{{ op.head_office_en }}</dd></div>{% endif %}
      {% if op.lab_en %}<div><dt>{{ t.co_lab }}</dt><dd>{{ op.lab_en }}</dd></div>{% endif %}
      {% if op.tel or op.email %}<div><dt>{{ t.co_contact }}</dt><dd>{% if op.tel %}{{ t.co_tel }} <a href="tel:+82{{ op.tel|replace('-', '')|replace('0', '', 1) }}">{{ op.tel }}</a>{% endif %}{% if op.tel and op.email %} · {% endif %}{% if op.email %}<a href="mailto:{{ op.email }}">{{ op.email }}</a>{% endif %}</dd></div>{% endif %}
      {% if site.editor and site.editor.name %}<div><dt>{{ ed_role }}</dt><dd><span lang="ko">{{ site.editor.name }}</span>{% if op.contact %} · <a href="mailto:{{ op.contact }}">{{ op.contact }}</a>{% endif %}</dd></div>{% endif %}
      {% if op.url %}<div><dt>{{ t.co_site }}</dt><dd><a href="{{ op.url }}" rel="noopener">{{ op.url }}</a></dd></div>{% endif %}
    </dl>
    <p class="co-note">{{ t.co_note }}</p>
  </div>
</section>
{%- endif %}

<section class="wrap chapter ch-rail" aria-labelledby="h-official">
  <h2 id="h-official" class="rail-label">{{ t.official_sites }}</h2>
  <div class="rail-body">
    <ul class="src-list">
      {% set city_link %}<a href="{{ site.source.url }}" rel="noopener" data-track="official_click">{{ t.city_tourism }}</a>{% endset %}
      <li>{{ t.f('in_korean_paren', name=city_link) }}</li>
      <li><a href="https://api.visitkorea.or.kr/" rel="noopener" data-track="official_click">{{ t.kto_tourapi }}</a></li>
    </ul>
  </div>
</section>
{% endblock %}
