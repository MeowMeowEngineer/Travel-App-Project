{% extends "base.html.j2" %}
{#- <home> of every version but Korean: the opening (owner 2026-10-10, as the Korean home: the official KOGL-1 photo full-bleed, H1 · lead · a button
    to the official courses · list counts, bottom bar with the next event and the photo credit), the centre question card (_ask.html.j2, owner 2026-10-13: its
    top straddles the dark end of the photo, below the credit line — never over it), tiles to the three hub
    guides then the lists, courses and events; places on the most official courses; upcoming events; official courses.
    Same Apple look as the Korean home (pipeline/en_site.Pages.home) with the accent points (owner, 2026-10-09;
    css/45-accent.css): the colour bento tiles, the big-numerals band, and the official courses as the black band. -#}
{% import "en/_en.html.j2" as E with context %}
{% import "_media.html.j2" as md %}
{% import "_ask.html.j2" as askm %}
{% block bodyclass %}pg-home pg-en-home{% endblock %}
{% block main_class %}{% endblock %}
{% block head %}{% if cover %}{{ md.preload(cover, '(min-width: 1024px) 680px, 100vw') }}{% endif %}{% endblock %}
{% block content %}
{#- the opening (ui4 2026-10-14, the owner's light reference layout): on a pale sea-blue ground the kicker · H1 · lead
    · the course button · list counts on the left, the official KOGL-1 photo big in a rounded frame on the right
    (under the text on phones), never darkened; a light bar with the next event and the photo credit
    (css/47-site-soft.css). No search in English: the links lead to the courses and the food list. -#}
<section class="hx{% if cover %} has-ph{% endif %}" aria-labelledby="h-home">
  <div class="wrap hx-in">
    <div class="hx-txt">
    <p class="hx-k">{{ t.f('home_kicker', r=region) }}</p>
    <h1 id="h-home" class="op-h1 hx-h1">{{ site.site_name }}</h1>
    <p class="hx-sub">{{ t.f('home_sub', r=region) }}</p>
    <p class="hx-cta">{% if n_courses %}<a class="hx-btn" href="{{ loc.home }}courses/" data-track="course_click">{{ t.home_cta }}<span class="arr" aria-hidden="true">→</span></a>{% endif %}</p>
    <p class="hx-cats">{% for kind, label, path in [('attraction', t.s('cat_attraction'), lists.attraction.path), ('food', t.s('cat_food'), lists.food.path), ('stay', t.s('cat_stay'), lists.stay.path)] if counts[kind] %}<a href="{{ path }}">{{ label }} <span class="tn">{{ counts[kind] }}</span><span class="arr" aria-hidden="true">›</span></a>{% endfor %}</p>
    </div>
    {% if cover %}<div class="hx-ph">{{ md.picture(cover, '(min-width: 1024px) 680px, 100vw', true, 'hx-img', false, true) }}</div>{% endif %}
  </div>
  {% set ev = hero_ev %}
  {% if ev or cover %}<div class="hx-bar"><div class="wrap hx-bar-in">
    {% if ev %}<a class="hx-ev" href="{{ loc.home }}events/#{{ ev.anchor }}"><span class="hx-dot" aria-hidden="true"></span>{% if ev.start and today and ev.start <= today %}{% set until %}<span class="tn">{{ loc.md(ev.last or ev.end) }}</span>{% endset %}<span class="hx-ev-c">{{ t.now_on }}{% if ev.last or ev.end %} · {{ t.f('until', d=until) }}{% endif %}</span> {% elif ev.start %}<span class="hx-ev-c tn">{{ loc.md(ev.start) }}{% if ev.end and ev.end != ev.start %}–{{ loc.md(ev.end) }}{% endif %}</span> {% endif %}<span class="hx-ev-t">{{ ev.name }}</span><span class="arr" aria-hidden="true">›</span></a>{% endif %}
    {% if cover %}{% set cover_link %}<a href="{{ cover.path }}">{{ cover.place }}</a>{% endset %}<p class="hx-cap">{{ t.f('photo_is', name=cover_link) }} · {{ E.credit(cover) }}</p>{% endif %}
  </div></div>{% endif %}
</section>
{% if ask_starters is defined and ask_starters is not none %}{{ askm.card(loc.html, region, ask_starters) }}{% endif %}

{% if tiles %}
<section class="abar" aria-label="{{ t.start_here }}">
<div class="wrap"><div class="abar-in">
<ol class="abar-p bento n{{ tiles|length }} en-tiles">{% for a in tiles %}{% call ui.bento(a) %}{% if a.pills %}{{ a.tiny }}{% else %}<span class="only-wide">{{ a.short }}</span><span class="only-narrow">{{ a.tiny or a.short }}</span>{% endif %}{% endcall %}{% endfor %}</ol>
</div></div>
</section>
{% endif %}

{% set T = namespace(i=0) %}
{% if featured %}
{% set T.i = T.i + 1 %}
<section class="sec sec-feat{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-feat">
  <div class="wrap"><div class="sh"><p class="eyebrow">{{ t.feat_eyebrow }}</p><h2 id="h-feat" class="h2">{{ ui.mark(t.s('feat_h'), '') }}</h2>{% if counts.attraction %}<a class="ch-link" href="{{ lists.attraction.path }}">{{ t.n('all_attractions', counts.attraction) }}<span class="arr" aria-hidden="true">›</span></a>{% endif %}</div></div>
  <div class="car car-feat" data-gallery>
    <div class="car-view" data-gal-view><ol class="cards cards-4 car-track">{% for c in featured %}<li>{{ E.card(c) }}</li>{% endfor %}</ol></div>
    <div class="wrap car-foot"><div class="car-nav" data-gal-nav><button type="button" class="gal-btn" data-dir="-1">{{ ui.icon('prev', 'icon') }}<span class="vh">{{ t.prev_place }}</span></button><button type="button" class="gal-btn" data-dir="1">{{ ui.icon('next', 'icon') }}<span class="vh">{{ t.next_place }}</span></button></div></div>
  </div>
</section>
{% endif %}

{% if hubs %}
{% set T.i = T.i + 1 %}
<section class="sec sec-ans{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-hubs">
  <div class="wrap"><div class="sh"><p class="eyebrow">{{ t.guides }}</p><h2 id="h-hubs" class="h2">{{ t.hubs_h }}</h2><a class="ch-link" href="{{ loc.home }}guides/" data-track="guide_click">{{ t.all_guides }}<span class="arr" aria-hidden="true">›</span></a></div>
  <ol class="answers answers-2 en-guides">{% for x in hubs %}<li><a class="ans" href="{{ x.path }}" data-track="guide_click"><span class="ans-k">{{ x.rec.label }}</span><span class="ans-n"><b class="num tn">{{ x.rec['items']|length }}</b><small>{{ t.n('places_unit', x.rec['items']|length) }}</small></span><span class="ans-v">{{ en.first_sentence(x.rec.summary) }}</span><span class="arr" aria-hidden="true">›</span></a></li>{% endfor %}</ol>
  </div>
</section>
{% endif %}

{% if events %}
{% set T.i = T.i + 1 %}
<section class="sec evband{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-ev">
  <div class="wrap">
    <div class="sh"><p class="eyebrow">{{ t.festivals }}</p><h2 id="h-ev" class="h2">{{ t.coming_up }}</h2><a class="ch-link" href="{{ loc.home }}events/">{{ t.all_events }}<span class="arr" aria-hidden="true">›</span></a></div>
    <ol class="evrows">{% for r in events %}
      <li class="evr"><a href="{{ loc.home }}events/#{{ r.anchor }}">
        {% if r.start %}<span class="evr-date"><span class="num tn">{{ loc.md(r.start) }}</span>{% if r.end and r.end != r.start %}<span class="num dash">–</span><span class="num tn">{{ loc.md(r.end) }}</span>{% endif %}</span>{% endif %}
        <span class="evr-name">{{ r.name }}</span>
        <span class="evr-meta">{% for row in r.rows if row.field in ('place_name', 'fee') and row.value and not row.blocks %}<span>{{ row.value }}</span>{% endfor %}</span>
        <span class="arr" aria-hidden="true">›</span>
      </a></li>{% endfor %}
    </ol>
  </div>
</section>
{% endif %}

{% if lines %}
{% set T.i = T.i + 1 %}
<section class="sec sec-co tone-2" aria-labelledby="h-co">
  <div class="wrap">
    <div class="sh"><p class="eyebrow pill-l"><span>{{ t.city_tourism }}</span></p><h2 id="h-co" class="h2">{{ t.lines_h }}</h2><a class="ch-link" href="{{ loc.home }}courses/" data-track="course_click">{{ t.all_courses }}<span class="arr" aria-hidden="true">›</span></a></div>
    <ol class="lines lines-home">
      {% for C in lines %}
      <li class="line-row">
        <span class="line-dur">{{ C.duration or C.group }}</span>
        <a class="line-name" href="{{ C.x.path }}" data-track="course_click">{{ C.name }}</a>
        {{ ui.stoprow(C.stops, t.s('stops_of', name=C.name), t.printf('plus_more')) }}
        <span class="line-meta tn">{{ t.n('n_stops', C.n_places) }}{% if C.complete and C.measured %} · {{ t.f('straight_line', d=loc.dist(C.total)) }}{% endif %}</span>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
{% endif %}
{% endblock %}
