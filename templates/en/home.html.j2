{% extends "base.html.j2" %}
{#- <home> of every version but Korean. UI4 for every version (owner 2026-10-14, '외국어 사이트들은 UI UX가 아직 업데이트가
    안 됐네'): the Korean home's opening and white card (templates/home.html.j2, css/46-home-open.css) with this version's
    words and pages — the official KOGL-1 photo full-bleed under its scrim (media.HOME_COVER, credited at the bottom
    right), at the left the kicker pill, the H1, the lede, the course button and the slide controls, at the right one
    card per news item (Pages.home_news: the Korean home's events and guides that have a page here, in this version's
    words; its photo with the place's page here, else its art in this language, else the 3D icon), one at a time
    (site.js [data-hcar], a native scroll-snap row without JS). Then the white card: the assistant (_ask.html.j2
    box_intl — no search page in these versions, so the form shows with JS only), the starter questions as '#' tags
    and the 3D icon menu (Pages.home_services); the conversation opens under it (panel_intl). Below: places on the
    most official courses, the hub guides, upcoming events and the official courses. Nothing on the first screen
    starts hidden. Phones (operator 2026-10-15): as the Korean home — the course button under the lede, compact news
    cards that do not turn by themselves, the launcher aside while the question box is on screen, and the menu led by
    the core four (Pages.home_services core) in one row of tiles; the 'getting there' tile shows HC.go there (the
    guide's own label, shown from 768px, is too long for a quarter of a phone). -#}
{% import "en/_en.html.j2" as E with context %}
{% import "_media.html.j2" as md %}
{% import "_ask.html.j2" as askm %}
{% import "_art.html.j2" as artm %}
{% import "_pic.html.j2" as pk %}
{#- the news card's picture: big from 768px, the compact card's 88px thumbnail below (as the Korean home) -#}
{% set SLIDE_SIZES = '(min-width: 1024px) 640px, (min-width: 768px) calc(100vw - 32px), 88px' %}
{% set SLIDE_MEDIA = '(min-width: 768px)' %}
{% set HC_ALL = {
  'en': {'news': 'News', 'all': 'All news',  'pause': 'Pause the news', 'play': 'Play the news', 'prev': 'Previous news', 'next': 'Next news',
         'event': 'Event', 'festival': 'Festival', 'guide': 'Guide', 'go': 'Getting here'},
  'ja': {'news': 'お知らせ', 'all': 'お知らせ一覧',  'pause': 'お知らせの自動切り替えを停止', 'play': 'お知らせの自動切り替えを開始', 'prev': '前のお知らせ',
         'next': '次のお知らせ', 'event': 'イベント', 'festival': '祭り', 'guide': 'ガイド', 'go': 'アクセス'},
  'zh-Hans': {'news': '最新消息', 'all': '全部消息',  'pause': '暂停自动播放', 'play': '开始自动播放', 'prev': '上一条', 'next': '下一条',
              'event': '活动', 'festival': '节庆', 'guide': '指南', 'go': '交通'},
  'zh-Hant': {'news': '最新消息', 'all': '全部消息',  'pause': '暫停自動播放', 'play': '開始自動播放', 'prev': '上一則', 'next': '下一則',
              'event': '活動', 'festival': '節慶', 'guide': '指南', 'go': '交通'},
  'de': {'news': 'Aktuelles', 'all': 'Alle Meldungen',  'pause': 'Automatischen Wechsel anhalten', 'play': 'Automatischen Wechsel starten',
         'prev': 'Vorherige Meldung', 'next': 'Nächste Meldung', 'event': 'Veranstaltung', 'festival': 'Festival', 'guide': 'Ratgeber',
         'go': 'Anreise'},
  'fr': {'news': 'Actualités', 'all': 'Toute l’actualité',  'pause': 'Mettre le défilement en pause', 'play': 'Reprendre le défilement',
         'prev': 'Actualité précédente', 'next': 'Actualité suivante', 'event': 'Événement', 'festival': 'Festival', 'guide': 'Guide',
         'go': 'Accès'},
  'es': {'news': 'Novedades', 'all': 'Todas las novedades',  'pause': 'Pausar el carrusel', 'play': 'Reanudar el carrusel', 'prev': 'Novedad anterior',
         'next': 'Novedad siguiente', 'event': 'Evento', 'festival': 'Festival', 'guide': 'Guía', 'go': 'Cómo llegar'},
  'ru': {'news': 'Новости', 'all': 'Все новости',  'pause': 'Остановить прокрутку новостей', 'play': 'Включить прокрутку новостей',
         'prev': 'Предыдущая новость', 'next': 'Следующая новость', 'event': 'Мероприятие', 'festival': 'Фестиваль',
         'guide': 'Путеводитель', 'go': 'Как добраться'},
} %}
{% set HC = HC_ALL.get(loc.html) or HC_ALL['en'] %}
{% block bodyclass %}pg-home pg-intl-home pg-h4{% if ask_starters is defined and ask_starters is not none %} has-ask{% endif %}{% endblock %}
{% block main_class %}{% endblock %}
{% block head %}{% if cover and cover.avif %}{{ md.preload(cover, '(min-width: 1024px) 100vw, 360px') }}{% endif %}{% set c0 = news[0] if news else none %}{% if c0 and c0.photo %}{% if c0.photo.type == 1 and c0.photo.avif %}{{ md.preload(c0.photo, SLIDE_SIZES, SLIDE_MEDIA) }}{% endif %}{% elif c0 and c0.art %}<link rel="preload" as="image" type="image/avif" imagesrcset="{{ c0.art.avif }}" imagesizes="{{ SLIDE_SIZES }}" media="{{ SLIDE_MEDIA }}" fetchpriority="high">{% endif %}{% endblock %}
{% block content %}
{% set N = news|length %}
{% set ASK = ask_starters is defined and ask_starters is not none %}
<div class="hk"{% if ASK %} data-chat-dock{% endif %}>
<section class="ho{% if cover %} ho-ph{% endif %}" aria-labelledby="h-home">
  {% if cover %}<div class="ho-bg" aria-hidden="true">{{ md.picture(cover, '(min-width: 1024px) 100vw, 360px', true, 'ho-bg-img', false, true) }}</div>{% endif %}
  <div class="wrap ho-in"{% if N %} data-hcar aria-roledescription="carousel" aria-label="{{ HC.news }}"{% endif %}>
    <div class="ho-text">
      <p class="ho-k"><span class="ho-dot" aria-hidden="true"></span>{{ t.f('home_kicker', r=region) }}</p>
      <h1 id="h-home" class="op-h1 hk-h1">{{ loc.home_h1 or site.site_name }}</h1>
      <p class="ho-lede">{{ t.f('home_sub', r=region) }}</p>
      <p class="ho-cta">{% if n_courses %}<a class="btn-sea" href="{{ loc.home }}courses/" data-track="course_click">{{ t.home_cta }}<span class="arr" aria-hidden="true">→</span></a>{% else %}<a class="btn-sea" href="{{ lists.attraction.path }}">{{ t.s('cat_attraction') }}<span class="arr" aria-hidden="true">→</span></a>{% endif %}</p>
      {% if N > 1 %}<div class="ho-ctl">
        <div class="hv-ctl">
          <button type="button" class="hv-c hv-pause" data-hcar-pause aria-label="{{ HC.pause }}" data-label-play="{{ HC.play }}" data-label-pause="{{ HC.pause }}">{{ ui.icon('pause', 'icon i-pause') }}{{ ui.icon('resume', 'icon i-play') }}</button>
          <button type="button" class="hv-c" data-hcar-dir="-1" aria-controls="hv-track" aria-label="{{ HC.prev }}">{{ ui.icon('prev') }}</button>
          <p class="hv-count tn" data-hcar-count aria-live="off"><span class="vh">{{ HC.news }} </span><span data-hcar-cur>1</span> / {{ N }}</p>
          <button type="button" class="hv-c" data-hcar-dir="1" aria-controls="hv-track" aria-label="{{ HC.next }}">{{ ui.icon('next') }}</button>
          <span class="hv-prog" aria-hidden="true"><i data-hcar-prog></i></span>
        </div>
        {% if events %}<a class="ho-all" href="{{ loc.home }}events/">{{ HC.all }}<span class="arr" aria-hidden="true">→</span></a>{% endif %}
      </div>{% endif %}
    </div>
    {% if N %}
    <div class="ho-news">
      <h2 class="vh">{{ HC.news }}</h2>
      <div class="hv-view" data-hcar-view>
        <div class="hv-track" id="hv-track">
          {% for c in news %}
          <article class="nc nc-{{ c.kind }}" role="group" aria-roledescription="slide" aria-label="{{ loop.index }} / {{ N }}" data-hcar-item>
            <div class="nc-frame{% if c.photo %} t{{ c.photo.type }}{% elif c.art %} nc-artf{% else %} nc-icof{% endif %}">
              {%- if c.photo %}{{ ui.img(c.photo, SLIDE_SIZES, loop.first, 'nc-img', false, loop.first) }}
              {%- elif c.art %}{{ artm.figure(c.art, loc.code, SLIDE_SIZES, loop.first, 'nc-art', false, loop.first) }}
              {%- else %}{{ pk.pic('guide' if c.kind == 'guide' else 'icon-events', 'book' if c.kind == 'guide' else 'calendar', 120) }}{% endif %}</div>
            <div class="nc-body">
              <p class="nc-chips"><span class="nc-chip">{{ HC[c.chip_key] }}</span>{% if c.start and today and c.start <= today %}<span class="nc-st"><span>{{ t.now_on }}{% if not c.end_month %}{% set until %}<span class="tn">{{ loc.md(c.end or c.start) }}</span>{% endset %} · {{ t.f('until', d=until) }}{% endif %}</span></span>{% endif %}</p>
              <h3 class="nc-t"><a href="{{ c.href }}"{% if c.track %} data-track="{{ c.track }}"{% endif %}>{{ c.title }}</a></h3>
              {% if c.start or c.sub %}<p class="nc-meta">{% if c.start %}<time datetime="{{ c.start }}" class="tn">{{ loc.md(c.start) }}{% if c.end and c.end != c.start %}–{{ loc.md(c.end) }}{% elif c.end_month %}–{{ loc.mon(c.end_month) }}{% endif %}</time>{% endif %}{% if c.start and c.sub %}<span aria-hidden="true"> · </span>{% endif %}{% if c.sub %}<span>{{ c.sub }}</span>{% endif %}</p>{% endif %}
              {% if c.photo %}{% set ph_link %}<a href="{{ c.photo.path }}">{{ c.photo.place }}</a>{% endset %}<p class="nc-cr">{{ t.f('photo_is', name=ph_link) }} · {{ E.credit(c.photo, false) }}{% if c.photo.lic %}<span class="cr-lic"> · {{ c.photo.lic }}</span>{% endif %}</p>{% endif %}
            </div>
          </article>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}
  </div>
  {% if cover %}{% set cover_link %}<a href="{{ cover.path }}">{{ cover.place }}</a>{% endset %}<p class="ho-cap">{{ t.f('photo_is', name=cover_link) }} · {{ E.credit(cover, false) }}{% if cover.lic %}<span class="cr-lic"> · {{ cover.lic }}</span>{% endif %}</p>{% endif %}
</section>
{% if ASK or services %}
<section class="hq"{% if ASK %} aria-labelledby="h-ask"{% endif %}>
  <div class="wrap"><div class="hq-card{{ ' hq-menu-only' if not ASK }}">
    {% if ASK %}{{ askm.box_intl(loc.html, ask_starters, region) }}{% endif %}
    {% if services %}
    <nav class="hq-menu" aria-label="{{ t.explore }}">
      <ul class="hq-row" style="--core:{{ services|selectattr('core')|list|length or 4 }}">
        {% for s in services %}<li class="{{ 'hq-core' if s.core else 'hq-more' }}"><a class="hq-i" href="{{ s.href }}"{% if s.track %} data-track="{{ s.track }}"{% endif %}>{{ pk.pic(s.pic, s.icon, 56) }}<span class="hq-l">{% if s.short and HC[s.short] %}<span class="hq-lw">{{ s.label }}</span><span class="hq-ls">{{ HC[s.short] }}</span>{% else %}{{ s.label }}{% endif %}</span>{% if s.n %}<span class="hq-n tn">{{ s.n }}</span>{% endif %}</a></li>{% endfor %}
      </ul>
    </nav>
    {% endif %}
  </div></div>
</section>
{% endif %}
{% if ASK %}{{ askm.panel_intl(loc.html) }}{% endif %}
</div>

{% set T = namespace(i=0) %}
{% if featured %}
{% set T.i = T.i + 1 %}
<section class="sec sec-feat{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-feat">
  <div class="wrap"><div class="sh"><p class="eyebrow">{{ t.feat_eyebrow }}</p><h2 id="h-feat" class="h2">{{ ui.mark(t.s('feat_h'), '') }}</h2>{% if counts.attraction %}<a class="ch-link" href="{{ lists.attraction.path }}">{{ t.n('all_attractions', counts.attraction) }}<span class="arr" aria-hidden="true">›</span></a>{% endif %}</div></div>
  <div class="car car-feat" data-gallery>
    <div class="car-view" data-gal-view><ol class="cards cards-4 car-track">{% for c in featured %}<li>{{ E.card(c) }}</li>{% endfor %}</ol></div>
    <div class="wrap car-foot"><div class="car-nav" data-gal-nav><button type="button" class="gal-btn" data-dir="-1">{{ ui.icon('prev', 'icon') }}<span class="vh">{{ t.prev_place }}</span></button><button type="button" class="gal-btn" data-dir="1">{{ ui.icon('next', 'icon') }}<span class="vh">{{ t.next_place }}</span></button></div></div>
  </div>
</section>
{% endif %}

{% if hubs %}
{% set T.i = T.i + 1 %}
<section class="sec sec-ans{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-hubs">
  <div class="wrap"><div class="sh"><p class="eyebrow">{{ t.guides }}</p><h2 id="h-hubs" class="h2">{{ t.hubs_h }}</h2><a class="ch-link" href="{{ loc.home }}guides/" data-track="guide_click">{{ t.all_guides }}<span class="arr" aria-hidden="true">›</span></a></div>
  <ol class="answers answers-2 en-guides">{% for x in hubs %}<li><a class="ans" href="{{ x.path }}" data-track="guide_click"><span class="ans-k">{{ x.rec.label }}</span><span class="ans-n"><b class="num tn">{{ x.rec['items']|length }}</b><small>{{ t.n('places_unit', x.rec['items']|length) }}</small></span><span class="ans-v">{{ en.first_sentence(x.rec.summary) }}</span><span class="arr" aria-hidden="true">›</span></a></li>{% endfor %}</ol>
  </div>
</section>
{% endif %}

{% if events %}
{% set T.i = T.i + 1 %}
<section class="sec evband{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-ev">
  <div class="wrap">
    <div class="sh"><p class="eyebrow">{{ t.festivals }}</p><h2 id="h-ev" class="h2">{{ t.coming_up }}</h2><a class="ch-link" href="{{ loc.home }}events/">{{ t.all_events }}<span class="arr" aria-hidden="true">›</span></a></div>
    <ol class="evrows">{% for r in events %}
      <li class="evr"><a href="{{ loc.home }}events/#{{ r.anchor }}">
        {% if r.start %}<span class="evr-date"><span class="num tn">{{ loc.md(r.start) }}</span>{% if r.end and r.end != r.start %}<span class="num dash">–</span><span class="num tn">{{ loc.md(r.end) }}</span>{% elif r.end_month %}<span class="num dash">–</span><span class="num tn">{{ loc.mon(r.end_month) }}</span>{% endif %}</span>{% endif %}
        <span class="evr-name">{{ r.name }}</span>
        <span class="evr-meta">{% for row in r.rows if row.field in ('place_name', 'fee') and row.value and not row.blocks %}<span>{{ row.value }}</span>{% endfor %}</span>
        <span class="arr" aria-hidden="true">›</span>
      </a></li>{% endfor %}
    </ol>
  </div>
</section>
{% endif %}

{% if lines %}
{% set T.i = T.i + 1 %}
<section class="sec sec-co tone-2" aria-labelledby="h-co">
  <div class="wrap">
    <div class="sh"><p class="eyebrow pill-l"><span>{{ t.city_tourism }}</span></p><h2 id="h-co" class="h2">{{ t.lines_h }}</h2><a class="ch-link" href="{{ loc.home }}courses/" data-track="course_click">{{ t.all_courses }}<span class="arr" aria-hidden="true">›</span></a></div>
    <ol class="lines lines-home">
      {% for C in lines %}
      <li class="line-row">
        <span class="line-dur">{{ C.duration or C.group }}</span>
        <a class="line-name" href="{{ C.x.path }}" data-track="course_click">{{ C.name }}</a>
        {{ ui.stoprow(C.stops, t.s('stops_of', name=C.name), t.printf('plus_more')) }}
        <span class="line-meta tn">{{ t.n('n_stops', C.n_places) }}{% if C.complete and C.measured %} · {{ t.f('straight_line', d=loc.dist(C.total)) }}{% endif %}</span>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
{% endif %}
{% endblock %}
