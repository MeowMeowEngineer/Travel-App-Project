{% extends "base.html.j2" %}
{% import "_p2.html.j2" as p2 %}
{% import "_media.html.j2" as md %}
{% import "_art.html.j2" as artm %}
{% import "_ask.html.j2" as askm %}
{% import "_pic.html.j2" as pk %}
{#- The home page. UI4 (owner 2026-10-14, after the AIO2O proposal demo for KT Skylife — its design language only;
    docs/handover/specs/ui4_mapping.md, skyref_study.md, home_redesign.md): a LIGHT opening — a soft sea-blue gradient,
    at the left the eyebrow pill (h.opening.kicker), the H1, one plain lede, the primary pill button and the slide
    controls (pause · ‹ n/N › · progress, '소식 전체'), at the right one big rounded card per news item
    (present.home_news: its real TourAPI photo, credited under it — KOGL-3 whole on a tinted frame, never cropped —
    or the outlet's own preview image, or its illustration; its chip, title and date), one at a time: a native
    scroll-snap row that works without JS, site.js [data-hcar] advances it every 6 s (never with reduced motion; it
    stops for hover, focus, a hidden tab, a swipe and the pause button). Then the white card overlapping the opening's
    bottom edge: the AI assistant (_ask.html.j2 box, owner 2026-10-14 '페이지 상단에는 검색, 중앙 부분에는 AI챗봇': its
    head, one question box with one button '물어보기', without JS the form searches; the site search itself is in the
    header), the recommended questions (ask.json) as '#' tags, and the 3D icon menu (present.home_services, pictures
    by ID through _pic.html.j2). The conversation opens right under the card (askm.panel, chat.js dock mode). Below: 목적별 가이드 → 대표 장소 → 다가오는 행사
    → 다섯 여행 권역 → 군산 이야기 (light now) → 섬 갤러리 → 공식 코스 → 영상 → 공식 안내, restyled with the
    reference's parts (css/46-home-open.css). Every figure comes from present.home_vm (h) or the list counts; a section
    whose data is missing is left out. Nothing on the first screen starts hidden. -#}
{% set SLIDE_SIZES = '(min-width: 1024px) 640px, calc(100vw - 32px)' %}
{% block bodyclass %}pg-home pg-ko-home{% endblock %}
{% block main_class %}{% endblock %}
{% block head %}{% if h.cover and h.cover.type == 1 and h.cover.avif %}{{ md.preload(h.cover, '(min-width: 1024px) 100vw, 360px') }}{% endif %}{% set c0 = h.news[0] if h.news else none %}{% if c0 and c0.photo %}{% if c0.photo.type == 1 and c0.photo.avif %}{{ md.preload(c0.photo, SLIDE_SIZES) }}{% endif %}{% elif c0 and c0.art and not c0.og %}<link rel="preload" as="image" type="image/avif" imagesrcset="{{ c0.art.avif }}" imagesizes="{{ SLIDE_SIZES }}" fetchpriority="high">{% endif %}{% endblock %}
{% block content %}
{% set T = namespace(i=0) %}
{% set N = h.news|length %}
{% set ASK = ask_starters is defined and ask_starters is not none %}
<div class="hk"{% if ASK %} data-chat-dock{% endif %}>
{#- the opening photo (owner 2026-10-14: '고화질 실사 배경'): media.HOME_COVER, an official KOGL-1 photo (cropping allowed,
    CLAUDE.md 3.4), full-bleed behind the opening under a navy scrim, its credit at the bottom right -#}
{% set cv = h.cover if h.cover and h.cover.type == 1 and h.cover.avif else none %}
<section class="ho{% if cv %} ho-ph{% endif %}" aria-labelledby="h-home">
  {% if cv %}<div class="ho-bg" aria-hidden="true">{{ md.picture(cv, '(min-width: 1024px) 100vw, 360px', true, 'ho-bg-img', false, true) }}</div>{% endif %}
  <div class="wrap ho-in"{% if N %} data-hcar aria-roledescription="carousel" aria-label="지금 {{ site.region }} 소식"{% endif %}>
    <div class="ho-text">
      <p class="ho-k"><span class="ho-dot" aria-hidden="true"></span>{{ h.opening.kicker }}</p>
      <h1 id="h-home" class="op-h1 hk-h1">{{ site.region ~ ' 여행의 모든 것' }}</h1>
      <p class="ho-lede">관광지·음식점·숙소의 여는 시간과 요금, 가는 길을 한곳에 모았습니다.</p>
      <p class="ho-cta">{% if courses %}<a class="btn-sea" href="/courses/" data-track="course_click">공식 코스 보기<span class="arr" aria-hidden="true">→</span></a>{% else %}<a class="btn-sea" href="/places/">가볼만한 곳 보기<span class="arr" aria-hidden="true">→</span></a>{% endif %}</p>
      {% if N > 1 %}<div class="ho-ctl">
        <div class="hv-ctl">
          <button type="button" class="hv-c hv-pause" data-hcar-pause aria-label="소식 자동 넘김 멈추기" data-label-play="소식 자동 넘김 시작" data-label-pause="소식 자동 넘김 멈추기">{{ ui.icon('pause', 'icon i-pause') }}{{ ui.icon('resume', 'icon i-play') }}</button>
          <button type="button" class="hv-c" data-hcar-dir="-1" aria-controls="hv-track" aria-label="이전 소식">{{ ui.icon('prev') }}</button>
          <p class="hv-count tn" data-hcar-count aria-live="off"><span class="vh">소식 </span><span data-hcar-cur>1</span> / {{ N }}</p>
          <button type="button" class="hv-c" data-hcar-dir="1" aria-controls="hv-track" aria-label="다음 소식">{{ ui.icon('next') }}</button>
          <span class="hv-prog" aria-hidden="true"><i data-hcar-prog></i></span>
        </div>
        <a class="ho-all" href="/events/">소식 전체<span class="arr" aria-hidden="true">→</span></a>
      </div>{% endif %}
    </div>
    {% if N %}
    <div class="ho-news">
      <h2 class="vh">지금 {{ site.region }} 소식</h2>
      <div class="hv-view" data-hcar-view>
        <div class="hv-track" id="hv-track">
          {% for c in h.news %}
          <article class="nc nc-{{ c.kind }}" role="group" aria-roledescription="slide" aria-label="{{ loop.index }} / {{ N }}" data-hcar-item>
            <div class="nc-frame{% if c.photo %} t{{ c.photo.type }}{% elif c.og %} nc-ogf{% elif c.art %} nc-artf{% else %} nc-icof{% endif %}">
              {%- if c.photo %}{{ ui.img(c.photo, SLIDE_SIZES, loop.first, 'nc-img', false, loop.first) }}
              {%- elif c.og %}<img class="nc-og" src="{{ c.og }}" alt="" width="600" height="315" loading="lazy" decoding="async" referrerpolicy="no-referrer">
              {%- elif c.art %}{{ artm.figure(c.art, 'ko', SLIDE_SIZES, loop.first, 'nc-art', false, loop.first) }}
              {%- else %}{{ pk.pic({'event': 'icon-events', 'festival': 'icon-events', 'video': 'icon-video', 'abroad': 'icon-abroad', 'guide': 'guide'}.get(c.kind, 'icon-events'), c.icon, 120) }}{% endif %}</div>
            <div class="nc-body">
              <p class="nc-chips"><span class="nc-chip">{{ c.chip }}</span>{% if c.status %}<span class="nc-st">{{ c.status }}</span>{% endif %}</p>
              <h3 class="nc-t"><a href="{{ c.href }}"{% if c.ext %} rel="noopener"{% endif %}{% if c.lang %} lang="{{ c.lang }}"{% endif %}{% if c.track %} data-track="{{ c.track }}"{% endif %}>{{ c.title }}{% if c.ext %}<span class="nc-x" aria-hidden="true">↗</span>{% endif %}</a></h3>
              {% if c.when or c.sub %}<p class="nc-meta">{% if c.when %}<time datetime="{{ c.when_iso }}" class="tn">{{ c.when }}</time>{% endif %}{% if c.when and c.sub %}<span aria-hidden="true"> · </span>{% endif %}{% if c.sub %}<span>{{ c.sub }}</span>{% endif %}</p>{% endif %}
              {% if c.photo %}<p class="nc-cr">사진 {{ c.photo.place }} · {{ md.credit(c.photo) }}</p>{% elif c.og %}<p class="nc-cr">사진: {{ c.outlet }} 미리보기 이미지</p>{% endif %}
            </div>
          </article>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}
  </div>
  {% if cv %}<p class="ho-cap">사진 <a href="{{ cv.path }}">{{ cv.place }}</a> · {{ md.credit(cv) }}</p>{% endif %}
</section>
{#- the white card: the AI assistant (_ask.html.j2 box: its head, one question box with one button '물어보기', the '#'
    tags — the site search is the header's, owner 2026-10-14), then the 3D icon menu of the service links. The menu has
    no '물어보기' item any more: the card right above it IS the assistant and the launcher is on screen too, so a third
    door to the same chat would only bring back the doubt the owner pointed at. Without the assistant (no ask.json)
    the card keeps the menu only: the search is in the header. -#}
{% if ASK or h.services %}
<section class="hq"{% if ASK %} aria-labelledby="h-ask"{% endif %}>
  <div class="wrap"><div class="hq-card{{ ' hq-menu-only' if not ASK }}">
    {% if ASK %}{{ askm.box(ask_starters, site.region) }}{% endif %}
    {% if h.services %}
    <nav class="hq-menu" aria-label="{{ site.region }} 여행 바로가기">
      <ul class="hq-row">
        {% for s in h.services %}<li><a class="hq-i" href="{{ s.href }}"{% if s.track %} data-track="{{ s.track }}"{% endif %}>{{ pk.pic(s.pic, s.icon, 56) }}<span class="hq-l">{{ s.label }}</span>{% if s.n %}<span class="hq-n tn">{{ s.n }}{{ s.unit }}</span>{% endif %}</a></li>{% endfor %}
      </ul>
    </nav>
    {% endif %}
  </div></div>
</section>
{% endif %}
{% if ASK %}{{ askm.panel() }}{% endif %}
</div>

{# 목적별 가이드: the answer tiles (figures checked against each guide's own text) and every guide #}
{% if h.answers %}
{% set T.i = T.i + 1 %}
<section class="sec sec-ans{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-ans">
  <div class="wrap">{{ ui.sec_head('목적별 가이드', '어떤 여행을 계획하세요?', 'h-ans', '/guides/' if h.guides else '', '가이드 ' ~ h.guides|length ~ '편 모두' if h.guides else '') }}</div>
  <div class="car car-ans" data-gallery>
    <div class="car-view" data-gal-view><ol class="answers answers-2 car-track">{% for a in h.answers %}{{ p2.answer(a) }}{% endfor %}</ol></div>
    <div class="wrap car-foot">{{ ui.carnav('답') }}</div>
  </div>
  {% if h.guides %}<div class="wrap"><p class="ans-more">{% for g in h.guides %}<a href="{{ g._path }}" data-track="guide_click">{{ g.label or g.title }}</a>{% endfor %}</p></div>{% endif %}
</section>
{% endif %}

{# 대표 장소: a stated rule (the attractions on most official courses); without such places, the first attractions with
   photos and visit information; without any place, the honest empty state #}
{% set T.i = T.i + 1 %}
{% if h.featured %}
<section class="sec sec-feat{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-feat">
  <div class="wrap">{{ ui.sec_head('공식 코스에 가장 많이 든 곳', '대표 장소', 'h-feat', '', '', site.source.name ~ ' 공식 코스 ' ~ n_courses ~ '개 가운데 ' ~ h.featured_min ~ '개 이상에 들어 있는 관광지') }}</div>
  <div class="car car-feat" data-gallery>
    <div class="car-view" data-gal-view><ol class="cards cards-4 car-track">{% for c in h.featured %}<li>{{ ui.card(c) }}</li>{% endfor %}</ol></div>
    <div class="wrap car-foot">{{ ui.carnav('장소') }}</div>
  </div>
</section>
{% elif featured %}
<section class="sec sec-feat{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-feat">
  <div class="wrap">{{ ui.sec_head('먼저 볼 곳', '대표 장소', 'h-feat', '/places/', '관광지 ' ~ counts.attraction ~ '곳 모두') }}</div>
  <div class="car car-feat" data-gallery>
    <div class="car-view" data-gal-view><ol class="cards cards-4 car-track">{% for e in featured[:4] %}<li>{{ ui.card(card_vm(e)) }}</li>{% endfor %}</ol></div>
    <div class="wrap car-foot">{{ ui.carnav('장소') }}</div>
  </div>
</section>
{% else %}
<section class="sec sec-feat p2-empty{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-feat">
  <div class="wrap">
    {{ ui.sec_head('먼저 볼 곳', '여행지 안내를 준비하고 있습니다', 'h-feat') }}
    <p class="p2-empty-t">방문 정보를 확인한 장소부터 안내합니다. 지금은 출처 사이트에서 확인하세요.</p>
    <p><a class="btn btn-ol" href="{{ site.source.url }}" rel="noopener" data-track="official_click">{{ site.source.name }}에서 확인</a></p>
  </div>
</section>
{% endif %}

{# 다가오는 행사: dated tiles ranked today → tomorrow → this week → running (present.ranked_events) #}
{% if has_events %}
{% set T.i = T.i + 1 %}
<section class="sec evband{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-ev">
  <div class="wrap">
    {{ ui.sec_head('행사·축제', '다가오는 행사', 'h-ev', '/events/', ('행사 ' ~ h.n_upcoming ~ '건 모두') if h.n_upcoming else '행사 일정 모두') }}
    {% if h.events_ranked %}<ol class="evrows">{% for r in h.events_ranked %}{{ ui.evrow(r) }}{% endfor %}</ol>
    {% else %}<p class="p2-none">진행 중이거나 일정이 발표된 행사가 없습니다. <a href="/events/">해마다 열리는 행사와 지난 회차</a></p>{% endif %}
  </div>
</section>
{% endif %}

{# 다섯 여행 권역: counts by 권역, the rule that drew them, and the anchors on a small map #}
{% if h.regions2 %}
{% set T.i = T.i + 1 %}
<section class="sec sec-reg{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-reg">
  <div class="wrap">
    {{ ui.sec_head('어디에 묵고 어디를 볼까', '권역별로 보는 ' ~ site.region, 'h-reg', '/map/', '권역·읍·면·동 지도') }}
    <div class="reg-grid">
      <div class="reg-main">
        <ol class="regs">
          {% for r in h.regions2 %}
          <li><a href="/map/#{{ r.id }}"><span class="rg-name">{{ r.name }}</span><span class="rg-n"><b class="num tn">{{ r.n }}</b><small>곳</small></span><span class="rg-k tn">관광지 {{ r.k.attraction or 0 }} · 숙소 {{ r.k.stay or 0 }} · 음식점 {{ r.k.food or 0 }}</span>{% if r.dongs %}<span class="rg-d">{{ r.dongs|join('·') }}</span>{% endif %}<span class="arr" aria-hidden="true">›</span></a></li>
          {% endfor %}
        </ol>
        <p class="rule-note">권역은 기준점 {{ h.regions2|length }}곳({% for r in h.regions2 %}{{ r.anchor.place }}{% if not loop.last %}·{% endif %}{% endfor %}) 가운데 직선거리로 가장 가까운 곳으로 묶었습니다.</p>
      </div>
      {{ ui.mapfig(h.region_map, site.region ~ ' 여행 권역 기준점 지도', 'reg-map', '권역 기준점 ' ~ h.regions2|length ~ '곳') }}
    </div>
  </div>
</section>
{% endif %}

{# 군산 이야기 — the page's one black section, also the accent black band (owner 2026-10-09): the oversized word over a
   hairline and the eyebrow as a lime pill. Desktop with motion: a CSS sticky stage (motion.js story); phones, reduced
   motion and no JS: dark tiles in DOM order. Every sentence is a place summary sentence (present.home_story). #}
{% if h.chapters %}
{% set y0 = h.chapters[0].big %}
<section class="story" data-story aria-labelledby="h-story">
  <div class="st-stage" data-stage>
    <div class="st-grid">
      <header class="st-head wrap">
        <p class="eyebrow pill-l"><span>{{ site.region }} 이야기</span></p>
        <h2 id="h-story" class="h2" data-split>{% if y0 is string and y0.isdigit() %}{{ y0 }}년부터 오늘까지{% else %}오늘의 {{ site.region }}{% endif %}</h2>
      </header>
      <p class="st-big" aria-hidden="true"><span class="num" data-roll>{{ y0 }}</span></p>
      <ol class="st-chs" data-n="{{ h.chapters|length }}">
        {% for c in h.chapters %}
        <li class="st-ch{% if loop.first %} is-on{% endif %}" id="{{ c.id }}" data-ch>
          {% if c.photo %}
          <figure class="st-ph t{{ c.photo.type }}" data-reveal-ph>
            <div class="st-frame">{{ ui.img(c.photo, '(min-width: 1024px) 940px, 300px', false, 'st-img') }}</div>
            <figcaption class="st-cap">{{ c.photo.place or c.photo.name }} · {{ md.credit(c.photo) }}</figcaption>
          </figure>
          {% endif %}
          <div class="st-text">
            <p class="st-year"><span class="num tn">{{ c.big }}</span>{% if c.kicker != c.big %}<span class="st-k">{{ c.kicker }}</span>{% endif %}</p>
            <h3 class="st-title">{{ c.title }}</h3>
            {% for t in c.text %}<p class="st-p">{{ t }}</p>{% endfor %}
            {% if c.steps %}<ol class="st-steps">{% for it in c.steps %}<li><span class="num tn">{{ it.y }}</span><div><a href="{{ it.path }}">{{ it.name }}</a><p>{{ it.text }}</p></div></li>{% endfor %}</ol>{% endif %}
            {% if c.figs %}<dl class="st-figs">{% for f in c.figs %}<div><dt>{{ f.label }}</dt><dd><span class="num tn" data-roll-fig>{{ f.n }}</span><small>{{ f.unit }}</small></dd></div>{% endfor %}</dl>{% endif %}
            {% if c.src %}<p class="ch-cite">근거: {% for name, path in c.src %}<a href="{{ path }}">{{ name }}</a>{% if not loop.last %} · {% endif %}{% endfor %} 장소 정보{% if c.figs %} · 좌표 사이 직선{% endif %}</p>{% elif c.figs %}<p class="ch-cite">근거: 한국관광공사 TourAPI 좌표 사이 직선</p>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ol>
      <ol class="st-rail" aria-label="이야기 순서" data-rail>{% for c in h.chapters %}<li><button type="button" data-go="{{ loop.index0 }}"{% if loop.first %} aria-current="step"{% endif %}><span class="num tn">{{ c.big }}</span>{% if c.kicker != c.big %} {{ c.kicker }}{% endif %}</button></li>{% endfor %}</ol>
    </div>
  </div>
</section>
{% endif %}

{# 섬 갤러리: an Apple carousel of island cards — KOGL-1 covers drift inside their frames, KOGL-3 stays whole #}
{% if h.gallery %}
{% set T.i = T.i + 1 %}
<section class="gallery{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-isl" data-gallery>
  <div class="wrap gal-head">
    {{ ui.sec_head('고군산군도', '다리로 이어진 섬들', 'h-isl', '', '', '', true) }}
    <p class="gal-fact">{% if h.gogun_km %}구 군산세관 본관에서 선유도까지 직선 <b class="tn">{{ h.gogun_km }}km</b> · {% endif %}고군산 권역 관광지 <b class="tn">{{ h.n_gogun }}곳</b></p>
  </div>
  <div class="car-view" data-gal-view>
    <ol class="gal-track car-track">
      {% for c in h.gallery %}<li>{{ ui.card(c, '', '(min-width: 1024px) 360px, 300px') }}</li>{% endfor %}
      <li class="gal-all"><a href="/places/?region=고군산">고군산 권역 관광지 <span class="tn">{{ h.n_gogun }}</span>곳 모두<span class="arr" aria-hidden="true">›</span></a></li>
    </ol>
  </div>
  <div class="wrap car-foot">{{ ui.carnav('장소') }}</div>
</section>
{% endif %}

{# 공식 코스: the 당일 lines (or the first lines) by their stops, and one of them on the map (present.course_map; map.js
   fetches the Kakao Maps SDK near the screen, after load) #}
{% if courses %}
{% set T.i = T.i + 1 %}
{% set lines = h.day_lines or h.lines[:3] %}
<section class="sec sec-co{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-co">
  <div class="wrap">
    {{ p2.sec_head(site.source.name ~ ' 공식', ('순서대로 따라가는 당일 코스' if h.day_lines else '순서대로 따라가는 공식 코스'), 'h-co', '/courses/', '코스 ' ~ n_courses ~ '개 모두', '', false, 'course_click') }}
    {% set tm = h.teaser.map if h.teaser else none %}
    <div class="co-grid2{% if not tm %} p2-co-one{% endif %}">
      <ol class="lines lines-home">
        {% for c in lines %}
        <li class="line-row">
          <span class="line-dur">{{ c.code or c.duration or c.group }}</span>
          <a class="line-name" href="{{ c.path }}" data-track="course_click">{{ c.title or c.display }}</a>
          {{ ui.stoprow(c.stops, (c.title or c.display) ~ ' 경유지 순서') }}
          {{ ui.linemeta(c) }}
        </li>
        {% endfor %}
      </ol>
      {% if tm %}{% set cv = h.teaser.cv %}
      <div class="co-teaser">
        <p class="cm-title"><span class="cm-k">지도</span><a href="{{ cv.path }}" data-track="course_click">{{ cv.display }}</a></p>
        {{ ui.coursemap(tm, cv.display ~ ' 경유지 지도') }}
      </div>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

{# 영상으로 보는 군산: one featured video (thumbnail facade — nothing loads from YouTube before the press), the top video
   of three topics, every topic with its count and its own page #}
{% if h.vfeat %}
{% set T.i = T.i + 1 %}
<section class="sec sec-vid{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-vid">
  <div class="wrap">
    {{ ui.sec_head('YouTube', '영상으로 보는 ' ~ site.region, 'h-vid', '/videos/', '영상 ' ~ h.n_videos ~ '편 모두') }}
    <div class="vgrid">
      <div class="v-feat">{{ ui.video(h.vfeat) }}</div>
      {% if h.vrows %}<ol class="v-rows">{% for r in h.vrows %}{{ p2.vtopic(r) }}{% endfor %}</ol>{% endif %}
    </div>
    <nav class="v-chips" aria-label="영상 주제">{% for c in h.vchips %}<a href="{{ c.path or ('/videos/#' ~ c.id) }}">{{ '그 밖의 영상' if c.title == '기타' else c.title }} <span class="tn">{{ c.n }}</span></a>{% endfor %}</nav>
  </div>
</section>
{% endif %}

{# 공식 안내: the official sites this one is built from (links only) #}
{% if site.official_links %}
{% set T.i = T.i + 1 %}
<section class="sec p2-official{{ ' tone-2' if T.i is odd }}" aria-labelledby="h-official">
  <div class="wrap">
    {{ ui.sec_head('공식 안내', site.region ~ ' 공식 관광 안내', 'h-official') }}
    <ul class="p2-links">{% for l in site.official_links %}<li><a href="{{ l.url }}" rel="noopener" data-track="official_click"><span class="p2-l-n">{{ l.name }}</span>{% if l.note %}<span class="p2-l-v">{{ l.note }}</span>{% endif %}{{ ui.icon('external', 'icon-sm') }}</a></li>{% endfor %}</ul>
  </div>
</section>
{% endif %}
{% endblock %}
