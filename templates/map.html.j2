{% extends "base.html.j2" %}
{% import "_art.html.j2" as artm %}
{#- /map/: every place by 권역 → 읍·면·동 (present.map_vm: regions [{name, id, anchor, members, k, dongs}], anchors,
    far_m, far_label, none_label, rule {method, lines, note}, n_geo, n_all, n_dong) beside a sticky map tile (desktop)
    or behind the 목록 | 지도 switch (phones). The 권역 rule in force is written on the page (CLAUDE.md 7): the anchor
    rule's sentence, or the district rule's lines made from the same configuration that assigned the places
    (pipeline/city.py region_rule_lines) and its note. Tabs, kind toggles and row ↔ marker
    highlighting are site.js ([data-region-tabs], [data-kinds], [data-segmap], [data-pt]); without JS the directory is
    the whole answer (the map tile, tabs and toggles are JS-only furniture). The tabs' and toggles' counts are faceted
    by site.js (a 권역 tab: its places of the kinds shown; a kind toggle: its places in the chosen 권역), the '지도 n'
    count, the count line (role="status", so a change is announced) and the map caption (places on it,
    [data-geo-cap]; not on it, [data-geo-off]) follow both. Each 권역
    section opens with its AI art band (area.<r.art>, site.json city.travel_regions; lazy). -#}
{% import "_p1.html.j2" as p1 %}
{% import "_filters.html.j2" as fb %}
{% set kl = {'attraction': '관광지', 'stay': '숙소', 'food': '음식점', 'cafe': '카페·디저트', 'shopping': '쇼핑'} %}
{% set mk = {'attraction': 'a', 'stay': 's', 'food': 'f', 'cafe': 'c', 'shopping': 'h'} %}
{#- the kind toggles and each 권역's kind counts: only the kinds the build has places of — a site with no 숙소 or 음식점
    yet showed '숙소 0 · 음식점 0' everywhere (UI review 2026-10-19, P2-6) -#}
{% set kinds = (['attraction'] if k_all.attraction else []) + (['stay'] if k_all.stay else []) + (['food'] if k_all.food else []) + (['cafe'] if k_all.cafe else []) + (['shopping'] if k_all.shopping else []) %}
{% block main_class %}{% endblock %}
{% block bodyclass %}pg-map{% endblock %}
{% block content %}
<section class="pg-hero band-s list-head" aria-labelledby="h-list">{{ artm.band((art_slots or {}).get('list.head.map')) }}
  <div class="wrap">
    <h1 id="h-list" class="h-list">{{ site.region }} 지도 <span class="count tn">{{ n_all }}곳</span></h1>
    {% set n_reg = (regions|rejectattr('name', 'equalto', none_label)|list|length) %}
    <p class="list-lede">{% if rule.method != 'none' and n_reg %}여행 권역 <span class="tn">{{ n_reg }}</span>곳 · {% endif %}읍·면·동 <span class="tn">{{ n_dong }}</span>곳 · 지도: 좌표가 있는 <span class="tn">{{ n_geo }}</span>곳</p>
    {% if rule.method == 'nearest_anchor' and anchors %}
    <details class="rule" id="h-rule">
      <summary>권역을 나눈 기준</summary>
      <p>좌표가 있는 곳은 기준점 {{ anchors|length }}곳 — {% for a in anchors %}<a href="{{ a.path }}">{{ a.place }}</a>({{ a.name }}){% if not loop.last %}, {% endif %}{% endfor %} — 가운데 직선거리로 가장 가까운 기준점의 권역에 넣었습니다.{% if far_m %} 가장 가까운 기준점까지 {{ (far_m / 1000)|int }}km를 넘는 섬은 ‘{{ far_label }}’으로 따로 뒀습니다.{% endif %} 좌표가 없는 곳은 주소의 읍·면·동이 같은 장소들이 가장 많이 속한 권역을 따랐고, 읍·면·동도 없으면 ‘{{ none_label }}’입니다.</p>
    </details>
    {% elif rule.method == 'district' %}
    <details class="rule" id="h-rule">
      <summary>권역을 나눈 기준</summary>
      <p>권역은 주소에 적힌 구·군(주소에 없으면 한국관광공사 TourAPI 법정동 코드의 구·군)으로 나눴고, 한 구·군을 둘로 나눈 곳은 주소의 법정동으로 나눴습니다.{% if rule.note %} {{ rule.note }}{% endif %} 맞는 권역이 없으면 ‘{{ none_label }}’입니다.</p>
      <ul class="rule-lines">{% for l in rule.lines %}<li>{{ l }}</li>{% endfor %}</ul>
    </details>
    {% endif %}
  </div>
</section>
<div class="wrap map-grid">
  <div class="map-dir">
    <div class="f-row region-tabs" role="group" aria-label="권역" data-region-tabs>
      <a href="#map-top" data-region="" aria-current="true">전체 <span class="tn">{{ n_all }}</span></a>
      {% for r in regions %}<a href="#{{ r.id }}" data-region="{{ r.name }}">{{ r.name }} <span class="tn">{{ r.members|length }}</span></a>{% endfor %}
    </div>
    <div class="f-row f-kinds" role="group" aria-label="종류" data-kinds>
      {% for k in kinds %}<button type="button" data-kind="{{ k }}" aria-pressed="true"><i class="mk mk-{{ mk[k] }}" aria-hidden="true"></i>{{ kl[k] }} <span class="tn">{{ k_all[k] or 0 }}</span></button>{% endfor %}
    </div>
    {#- the count line (site.js data-tpl, data-of while filtered): the places shown for the chosen 권역 and kinds — a
        status region, so every change of the count, 0 among them, is announced (outside evaluation 2026-10-18); the
        목록 | 지도 switch beside it on phones -#}
    <div class="f-tools map-tools js-only">
      <p class="f-result" role="status"><span data-map-result data-tpl="장소 {n}곳" data-of=" (전체 {m}곳 중)">장소 {{ n_all }}곳</span></p>
      {% if n_geo %}<div class="seg seg-map" role="group" aria-label="보기" data-segmap><button type="button" data-view="list" aria-pressed="true">목록</button><button type="button" data-view="map" aria-pressed="false">지도 <span class="tn">{{ n_geo }}</span></button></div>{% endif %}
    </div>
    {#- nothing left for the chosen 권역 and kinds (site.js): the sentence and the buttons that bring places back — the
        권역 ('<권역> 조건 해제'), a hidden kind ('<종류> 숨김 해제', data-kind-one), each only when it alone brings
        some back, then the reset of both; outside the 권역 sections, so the phone's 지도 view shows it too -#}
    <p class="empty" data-map-empty hidden>고른 권역과 종류에 맞는 곳이 없습니다.</p>
    <div class="f-undo" data-map-undo data-one="{{ list_words.clear_one }}" data-kind-one="{v} 숨김 해제" hidden><button type="button" data-map-reset>{{ list_words.clear_all }}</button></div>
    <div id="map-top"></div>
    {% set seen = namespace(names=[]) %}
    {% for r in regions %}{% set rloop = loop %}
    <section class="region{% if not loop.first %} cvk{% endif %}" id="{{ r.id }}" data-region-sec="{{ r.name }}" aria-labelledby="{{ r.id }}-h"{% if not loop.first %} style="contain-intrinsic-size:auto {{ 200 + r.members|length * 38 + r.dongs|length * 48 }}px"{% endif %}>{{ artm.strip((art_slots or {}).get('area.' ~ r.art) if r.art else none) }}
      <div class="region-head">
        <h2 id="{{ r.id }}-h">{{ r.name }} <span class="count tn" data-group-n>{{ r.members|length }}곳</span></h2>
        <p class="region-k tn">{% for k in kinds %}<span data-rk="{{ k }}">{{ kl[k] }} {{ r.k[k] or 0 }}</span>{% endfor %}{% if r.anchor %}<span class="rk-a">기준점 <a href="{{ r.anchor.path }}">{{ r.anchor.place }}</a></span>{% endif %}</p>
      </div>
      <div class="dongs">
        {% for d in r.dongs %}
        {# the round-2 anchor /map/#<읍·면·동> still lands on that 동's first group (a 동 can fall in two 권역) #}
        {% set old_id = d.name if (d.name not in seen.names and ' ' not in d.name) else '' %}{% if old_id %}{% set seen.names = seen.names + [d.name] %}{% endif %}
        {#- every group but the page's first is skipped off screen too: the first 권역 starts on the first screen, and
            its 동 lists alone needed most of the font files (QA 2026-10-19 QA-28: /map/ 332 KB) -#}
        {% set first_dong = rloop.first and loop.first %}
        <section class="dong{% if not first_dong %} cvk{% endif %}" aria-labelledby="{{ d.id }}"{% if old_id %} id="{{ old_id }}"{% endif %}{% if not first_dong %} style="contain-intrinsic-size:auto {{ 40 + d.members|length * 44 }}px"{% endif %}>
          <h3 id="{{ d.id }}">{{ d.name }} <span class="tn" data-group-n>{{ d.members|length }}</span></h3>
          <ul>{% for e in d.members %}<li data-kind-row="{{ e.kind }}"{% if e._geo %} data-pt="{{ e.slug }}"{% endif %}><i class="mk mk-{{ mk[e.kind] }}" aria-hidden="true"></i><a href="{{ e._path }}">{{ e.name }}</a><span class="vh"> ({{ kl[e.kind] }})</span></li>{% endfor %}</ul>
        </section>
        {% endfor %}
      </div>
    </section>
    {% endfor %}
  </div>
  {% if n_geo %}
  <aside class="map-side" aria-label="{{ site.region }} 권역 지도">
    {{ p1.placemap({'all': points, 'anchor_pts': anchors}, site.region ~ ' 권역 지도', 'all-mapfig', '좌표가 있는 ' ~ n_geo ~ '곳', fb.off_map(n_all - n_geo, list_words)) }}
  </aside>
  {% endif %}
</div>
{% endblock %}
