{% macro box(starters, region='') -%}
<div class="hk-ask" data-ask-zone>
  <div class="hk-head">
    {{ mm.pic('mascot-hello', 'small', 64, 'hk-mascot') }}
    <h2 id="h-ask" class="hk-h"><span class="hk-hn">{{ (region ~ ' ') if region }}여행 도우미에게</span> 물어보세요</h2>
    <p class="hk-sub" data-ask-line>AI가 이 사이트에 실린 정보로 답하고, 답마다 출처 페이지를 붙입니다.</p>
    <p class="hk-note">대화는 이 탭에만 임시 보관됩니다 · <a href="/about/#chatbot">도우미 안내</a></p>
  </div>
  <form class="hk-box" action="/search/" method="get" data-ask-form="search" data-empty="질문을 먼저 적어 주세요">
    <label for="ask-q" class="vh">도우미에게 물을 질문</label>
    {{ ui.icon('chat', 'hk-ico') }}
    <input id="ask-q" name="q" type="text" maxlength="800" autocomplete="off" enterkeyhint="send" spellcheck="false" placeholder="궁금한 것을 적어 주세요" data-ask-q>
    <button type="submit" class="ask-go hk-go" data-ask-go><span class="ask-go-l">물어보기</span><span class="ask-go-l ask-go-s">멈추기</span></button>
  </form>
  <p class="vh" aria-live="polite" data-ask-hint></p>
  <p class="hk-nojs">자바스크립트가 꺼져 있어 지금은 질문을 사이트 검색 결과로 보여 드리고, 예시 질문은 답이 실린 페이지로 연결합니다.</p>
  {% if starters %}<ul class="hk-pills" aria-label="예시 질문">{% for x in starters %}<li><a class="hk-pill" href="{{ x.href }}" data-ask="{{ x.q }}">{{ x.q }}</a></li>{% endfor %}</ul>{% endif %}
</div>
{%- endmacro %}
{% macro panel() -%}
<div class="wrap hk-conv"><div class="ask-log ask-panel" data-ask-log hidden data-ask-more="이어서 물어보기" data-note="AI가 이 사이트의 정보로 쓴 답입니다. 틀릴 수 있으니 방문 전에 확인하세요." data-fail="답을 불러오지 못했습니다. 잠시 뒤 다시 시도해 주세요."></div></div>
{%- endmacro %}
{#- box_intl(lang, starters, region) and panel_intl(lang) — the same card on the other language versions' homes (owner
    2026-10-14: '외국어 사이트들은 UI UX가 아직 업데이트가 안 됐네' — they take the Korean home's design). Those versions
    have no search page, so the form is the assistant only: it shows with JS (data-js-only; chat.js dock mode), and
    without JS the '#' tags stay links to the pages that answer them, which a line shown only then says (nojs). With JS
    they ask, as on the Korean home. Words from ASK_S: bh (the heading), ok (how it
    answers), terms (AI answers can be wrong · chats stay in this tab, questions go to Anthropic) with the help page, the field and its button. -#}
{% macro box_intl(lang, starters, region='') -%}
{%- set s = ASK_S.get(lang) or ASK_S['en'] -%}
<div class="hk-ask hk-intl" data-ask-zone>
  <div class="hk-head">
    {{ mm.pic('mascot-hello', 'small', 64, 'hk-mascot') }}
    <h2 id="h-ask" class="hk-h">{{ s.bh|replace('{r}', region) }}</h2>
    <p class="hk-sub" data-ask-line>{{ s.ok }}</p>
    <p class="hk-note">{{ s.terms }} · <a href="{{ s.about }}"{% if lang not in ('ko', 'en') and s.about.startswith('/en/') %} hreflang="en"{% endif %}>{{ s.about_l }}</a></p>
  </div>
  <form class="hk-box" method="get" data-ask-form data-js-only data-empty="{{ s.empty }}">
    <label for="ask-q" class="vh">{{ s.label }}</label>
    {{ ui.icon('chat', 'hk-ico') }}
    <input id="ask-q" name="q" type="text" maxlength="800" autocomplete="off" enterkeyhint="send" spellcheck="false" placeholder="{{ s.ph }}" data-ask-q>
    <button type="submit" class="ask-go hk-go" data-ask-go><span class="ask-go-l">{{ s.go }}</span><span class="ask-go-l ask-go-s">{{ s.stop }}</span></button>
  </form>
  <p class="vh" aria-live="polite" data-ask-hint></p>
  {% if starters %}<p class="hk-nojs">{{ s.nojs }}</p>{% endif %}
  {% if starters %}<ul class="hk-pills" aria-label="{{ s.sug }}">{% for x in starters %}<li><a class="hk-pill" href="{{ x.href }}" data-ask="{{ x.q }}">{{ x.q }}</a></li>{% endfor %}</ul>{% endif %}
</div>
{%- endmacro %}
{% macro panel_intl(lang) -%}
{%- set s = ASK_S.get(lang) or ASK_S['en'] -%}
<div class="wrap hk-conv"><div class="ask-log ask-panel" data-ask-log hidden data-ask-more="{{ s.ph }}" data-note="{{ s.terms }}" data-fail="{{ s.fail }}"></div></div>
{%- endmacro %}
{% macro card(lang, region, starters, dark_top=false, search_alt=true) -%}
{%- set s = ASK_S.get(lang) or ASK_S['en'] -%}
{%- set search = s.alt != '' -%}
<section class="ask{{ ' ask-dark' if dark_top }}{{ ' ask-jsonly' if not search }}" aria-labelledby="h-ask" data-chat-dock>
  <div class="wrap"><div class="ask-card">
    {#- the kicker's mark stays the line glyph on its tinted circle even when icon-ask has a picture: the card is text
        only, nothing for the first paint to wait for -#}
    <p class="ask-k"><span class="pic pic-tmp ask-k-pic" data-pic="icon-ask" style="--pic:32px" aria-hidden="true">{{ ui.icon('chat', 'icon pic-g') }}</span>{{ s.k }}</p>
    <h2 id="h-ask" class="ask-h">{{ s.h|replace('{r}', region) }}</h2>
    <form class="ask-box"{% if search %} action="/search/"{% endif %} method="get" data-ask-form{{ '="search"'|safe if search }} data-empty="{{ s.empty }}">
      <div class="ask-row">
        <label for="ask-q" class="vh">{{ s.label }}</label>
        {{ ui.icon('search', 'ask-ico') }}
        <input id="ask-q" name="q" type="text" maxlength="800" autocomplete="off" enterkeyhint="send" spellcheck="false" placeholder="{{ s.ph }}" data-ask-q>
        <button type="submit" class="ask-go" data-ask-go><span class="ask-go-l">{{ s.go }}</span><span class="ask-go-l ask-go-s">{{ s.stop }}</span></button>
      </div>
      <p class="ask-meta"><span class="only-wide" data-ask-line>{{ s.m }}</span><span class="only-narrow" data-ask-line>{{ s.ms }}</span>{% if search and search_alt %}<button type="submit" class="ask-alt" formaction="/search/" data-ask-search>{{ ui.icon('search', 'icon') }}{{ s.alt }}</button>{% endif %}</p>
    </form>
    <p class="vh" aria-live="polite" data-ask-hint></p>
    {% if starters %}<div class="ask-sug"><p class="ask-sug-l" id="ask-sug-l">{{ s.sug }}</p><ul class="ask-chips" aria-labelledby="ask-sug-l">{% for x in starters %}<li><a class="ask-chip" href="{{ x.href }}" data-ask="{{ x.q }}">{{ x.q }}</a></li>{% endfor %}</ul></div>{% endif %}
    <div class="ask-log" data-ask-log hidden data-fail="{{ s.fail }}"></div>
    <p class="ask-foot"><span class="ask-ok"><span class="ask-tick" aria-hidden="true">✓</span>{{ s.ok }}</span><span class="ask-terms">{{ s.terms }} · <a href="{{ s.about }}"{% if lang not in ('ko', 'en') and s.about.startswith('/en/') %} hreflang="en"{% endif %}>{{ s.about_l }}</a></span></p>
  </div></div>
</section>
{%- endmacro %}
